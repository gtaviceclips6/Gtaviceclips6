name: Prueba Telegram
on:
  workflow_dispatch:
jobs:
  saludo:
    runs-on: ubuntu-latest
    steps:
      - name: Mandar mensaje de prueba
        env:
          TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
        run: |
          curl -s --fail -X POST "https://api.telegram.org/bot${TOKEN}/sendMessage" \
            -d chat_id="${CHAT_ID}" \
            --data-urlencode text="✅ ¡Hola! Soy el bot de Vice GTA6 Clips. Ya estoy conectado."
